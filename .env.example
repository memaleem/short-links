# מעתיקים את הקובץ הזה ל-.env.local וממלאים את הערכים.
# ב-Vercel מזינים את אותם משתנים ב-Settings -> Environment Variables.

# מפרויקט הסופרבייס שלך: Settings -> API
# ה-URL של הפרויקט (https://xxxx.supabase.co)
SUPABASE_URL=
# המפתח הסודי (service_role, לא anon!) - לשמור בסוד, הוא נותן גישה מלאה למסד
SUPABASE_SERVICE_ROLE_KEY=

# סיסמת הכניסה ללוח הבקרה - בוחרים סיסמה חזקה
PANEL_PASSWORD=
# מחרוזת אקראית ארוכה לחתימת העוגייה. להפיק עם: openssl rand -hex 32
AUTH_SECRET=

# הדומיין הקצר, בלי https:// (למשל: link.mydomain.co.il)
NEXT_PUBLIC_SHORT_HOST=

# מחרוזת סודית לדף "המפה" (הדף יהיה זמין בכתובת /h/<HUB_SECRET>)
# להפיק עם: openssl rand -hex 16
HUB_SECRET=
